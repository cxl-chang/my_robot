<launch>
    <let name="urdf_path"
         value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro" />

     <let name="gazebo_config_path"
         value="$(find-pkg-share my_robot_bringup)/config/gazebo_bridge.yaml" />

    <!-- <let name="rviz_config_path"
        value="$(find-pkg-share my_robot_description)/rviz/config.rviz" /> -->

    <let name="rviz_config_path"
        value="$(find-pkg-share my_robot_description)/rviz/config_camera_arm.rviz" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
                value="$(command 'xacro $(var urdf_path)')" />
        <!-- Gazebo 仿真时钟：与 /joint_states 的仿真时间戳保持一致 -->
        <param name="use_sim_time" value="true" />
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" >
        <!-- <arg name="gz_args" value="empty.sdf -r" /> -->
        <arg name="gz_args" value="$(find-pkg-share my_robot_bringup)/worlds/test_world.sdf -r" />
    </include>

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config_path)" />
    </node>

    <!-- 机械臂由 gz_ros2_control 驱动：ros2_control 框架由 GZ 侧插件 GazeboSimROS2ControlPlugin 内置创建，
         因此不需要独立的 ros2_control_node 节点，spawner 直接连插件创建的 controller_manager -->
    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />
    <node pkg="controller_manager" exec="spawner" args="arm_controller" />
    <node pkg="controller_manager" exec="spawner" args="gripper_controller" />
    <!-- <node pkg="controller_manager" exec="spawner" args="diff_drive_controller" /> -->

    <!-- move_group 必须用仿真时钟，否则取不到"当前"关节状态（轨迹执行会 ABORTED） -->
    <include file="$(find-pkg-share my_robot_moveit_config)/launch/move_group.launch.py">
        <arg name="use_sim_time" value="true" />
    </include>

    <node pkg="rviz2" exec="rviz2"  output="screen" args=" -d $(var rviz_config_path)">
        <param name="use_sim_time" value="true" />
    </node>

</launch>