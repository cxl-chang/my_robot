        <visual name='cube_visual'>
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <!-- 调亮：ArUco 需要标记四周有浅色背景才能定出黑方块边界；
               原来深红(0.8,0.2,0.2)灰度仅 ~97，与黑底板(<30)融为一体 → 识别必然失败 -->
          <material>
            <ambient>0.85 0.45 0.42 1</ambient>
            <diffuse>0.95 0.55 0.52 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <!-- 纯几何 ArUco 标签（id=0，黑色底板 + 白色模块，无贴图依赖；Gazebo 贴图不可靠） -->
        <!-- 白色衬底：ArUco 必须有**浅色**边环才能定出黑方块的边界。
             原来黑底板 48mm 贴在 50mm 方块面上，四周只剩 1mm，检测器根本
             找不到这个黑方块（只能把内部白模块当候选）→ 识别必然失败。
             现在：黑标签 32mm + 白衬底 46mm = 每边 7mm 浅色边环（≈1.3 个模块宽）。 -->
        <visual name='aruco_white'>
          <pose>-0.026 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.002 0.046 0.046</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
