<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="Arm" type="system">
         <!--ros2_control 硬件接口直接接入Gazebo物理仿真替代原
         mock_components/GenericSystem (纯模拟，不连接 Gazebo，导致 TF 双源冲突)-->
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="joint1">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <joint name="joint2">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <joint name="joint3">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <joint name="joint4">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <joint name="joint5">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <joint name="joint6">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <joint name="gripper_left_finger_joint">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
        <!-- 右指也必须纳入 ros2_control：
             gripper.xacro 里右指原本用 URDF <mimic joint="gripper_left_finger_joint">
             跟随左指，但本仿真后端 Ignition Gazebo 6 (Fortress) / sdformat12
             的 SDF 1.9 规范里没有 mimic 元素，URDF 转 SDF 时 mimic 被丢弃，
             右指成了一个没有驱动、没有约束的自由滑动关节 —— 表现为"合爪时
             只有左指动、右指被推着乱跑、夹不住物体"。这里改成双指都直接驱动，
             由 gripper_controller 同时给两个关节发位置指令。 -->
        <joint name="gripper_right_finger_joint">
            <command_interface name="position"/>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
    </ros2_control>

    <!-- 注意：MobileBase（差速轮）不纳入 ros2_control，
         底盘由 GZ 的 DiffDrive 插件驱动（见 mobile_base_gazebo.xacro），
         轮子状态经 gazebo_bridge.yaml 桥接发布到 /joint_states -->

    <!-- gz_ros2_control 的 GZ 侧插件：在 Gazebo 仿真中创建 ros2_control 框架（controller_manager），
         因此 launch 中不再需要独立的 ros2_control_node 节点（参考 gz_ros2_control_demos 示例） -->
    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find my_robot_bringup)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>
</robot>
