<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org.wiki/xacro">
    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />
    
    <link name="base_footlink">
    </link>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${base_height/2.0}" rpy="0.0 0.0 0.0"/>
            <material name="blue" />
        </visual>

        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${base_height/2.0}" rpy="0.0 0.0 0.0"/>            
        </collision>

        <xacro:box_inertia m="15.0" x="${base_length}" y="${base_width}" z="${base_height}"
                           o_xyz="0.0 0.0 ${base_height/2.0}" o_rpy="0 0 0" />
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="${pi/2} 0.0 0.0" />
                <material name = "grey"/>
            </visual>

            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            </collision>

            <xacro:cylinder_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}"
                                o_xyz="0.0 0.0 0.0" o_rpy="${pi/2} 0.0 0.0" />
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius/2.0}"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0 0.0 0.0" />
            <material name = "grey"/>
        </visual>

        <collision>
             <geometry>
                <sphere radius="${wheel_radius/2.0}"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />               
        </collision>

        <xacro:sphere_inertia m="0.5" r="${wheel_radius/2.0}"
                                o_xyz="0.0 0.0 0.0" o_rpy="0.0 0.0 0.0" />
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footlink"/>
        <child link="base_link"/>
        <!-- 【必须偏 base_length/4】驱动轮在 base_link 的 x=-base_length/4（见下面
             两个轮子关节），差速原地转的转心就是轮轴中点；而导航栈的
             robot_base_frame 用的正是 base_footlink。若把 base_footlink 放在
             base_link 正下方，一次"原地转"就会把 Nav2 的控制点沿半径 0.15m 的
             圆推着走：到点对齐永远差 15cm（实测放置接近点空转 78s、转了 11 圈），
             抓取目标也随之系统性偏 15cm，而且 odom（差速插件按"绕 base 帧积分"）
             与真实运动不符、AMCL 得一直纠。
             把根坐标系移到轮轴中点后：原地转不再产生位移、odom 与物理一致，
             机械臂/相机等 base_link 系几何全都不变。 -->
        <origin xyz="${base_length/4.0} 0 ${wheel_radius}" rpy="0.0 0.0 0.0"/>
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="${-base_length/4.0} -0.225 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

     <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="${-base_length/4.0} 0.225 0.0" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="0.2 0.0 -0.05" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>
</robot>